# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
DB_ENABLED=false
DB_INIT_SCHEMA=false
DB_SCHEMA_PATH=sql/schema.sql
# Option A: single DSN
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pokecollect
# Option B: split credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pokecollect
DB_USER=postgres
DB_PASSWORD=postgres

# Webhook Configuration
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
# Optional: path to public certificate file for self-signed HTTPS webhook
WEBHOOK_CERT_PATH=

# Server Configuration
HOST=0.0.0.0
PORT=8000
