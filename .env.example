# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_BOT_TOKEN=your_admin_bot_token_here
ADMIN_BOT_ALLOWED_IDS=123456789
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
DB_ENABLED=false
DB_INIT_SCHEMA=false
DB_SCHEMA_PATH=sql/schema.sql
# Option A: single DSN
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pokecollect
# Option B: split credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pokecollect
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration (optional; recommended for shared menu sessions)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0

# Webhook Configuration
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
# Optional: path to public certificate file for self-signed HTTPS webhook
WEBHOOK_CERT_PATH=
ADMIN_BOT_WEBHOOK_URL=https://your-domain.com
ADMIN_BOT_WEBHOOK_PATH=/admin-webhook
ADMIN_BOT_WEBHOOK_CERT_PATH=
# Optional: public HTTPS URL of the Telegram Mini App frontend (for Web App button)
MINI_APP_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ADMIN_BOT_HOST=0.0.0.0
ADMIN_BOT_PORT=8001
